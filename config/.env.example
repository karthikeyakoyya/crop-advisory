# ---------------------------------------------------------------------------
# Copy this file to `.env` in the project root and fill in your own values.
# Never commit the real `.env` file to version control.
# ---------------------------------------------------------------------------

# PostgreSQL connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crop_advisory
POSTGRES_USER=crop_advisory_user
POSTGRES_PASSWORD=change_me

# Built automatically by config/settings.py, override if you prefer a full URL
# DATABASE_URL=postgresql://crop_advisory_user:change_me@localhost:5432/crop_advisory

# MLflow tracking (sqlite backend — the filesystem store is in maintenance
# mode as of MLflow 2.x and no longer recommended)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=crop_yield_advisory

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Random seed used everywhere data is simulated, for reproducibility
RANDOM_SEED=42
